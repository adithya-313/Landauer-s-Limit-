# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# STAGE 1: Export ONNX model and cache tokenizer
# ---------------------------------------------------------------------------
FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b AS export

WORKDIR /export

RUN pip install --no-cache-dir \
    torch==2.5.1+cpu \
    --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir \
    transformers==5.12.1 \
    onnxruntime==1.24.2 \
    onnx \
    numpy==1.26.4

COPY micro_lab.py /export/

ENV HF_HOME=/hf
RUN python -c "\
from transformers import AutoTokenizer;\
import micro_lab;\
import hashlib;\
model_name = 'sentence-transformers/all-MiniLM-L6-v2';\
AutoTokenizer.from_pretrained(model_name);\
micro_lab.load_onnx_model(model_name, '/export/all-MiniLM-L6-v2.onnx');\
h = hashlib.sha256(open('/export/all-MiniLM-L6-v2.onnx', 'rb').read()).hexdigest();\
open('/export/all-MiniLM-L6-v2.onnx.sha256', 'w').write(h + '\n');\
"

# ---------------------------------------------------------------------------
# STAGE 2: Slim CPU Runtime
# ---------------------------------------------------------------------------
FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b AS runtime

RUN useradd -m -u 1000 appuser

WORKDIR /app

COPY requirements-gateway.lock /tmp/requirements-gateway.lock
COPY requirements-migrations.lock /tmp/requirements-migrations.lock
RUN pip install --no-cache-dir -r /tmp/requirements-gateway.lock \
    && python -m venv /opt/migrate \
    && /opt/migrate/bin/pip install --no-cache-dir -r /tmp/requirements-migrations.lock \
    && rm /tmp/requirements-gateway.lock /tmp/requirements-migrations.lock

# Explicitly copy source files imported by gateway
COPY gateway.py \
     start_gateway.py \
     admin_routes.py \
     admission_controller.py \
     circuit_breaker.py \
     decision_table.py \
     engine_config.py \
     gpu_monitor.py \
     guardrail.py \
     metering.py \
     model_manifest.py \
     payload_guard.py \
     pg_writer.py \
     pricing.py \
     protective_actions.py \
     quota.py \
     request_queue.py \
     semantic_cache.py \
     telemetry.py \
     tenant_cache.py \
     tenants.py \
     /app/

COPY adapters /app/adapters
COPY alembic.ini /app/alembic.ini
COPY migrations /app/migrations
COPY db /app/db
COPY config/pricing.yaml /app/pricing/pricing.yaml

# Copy exported ONNX model and cached HuggingFace tokenizer
COPY --from=export /export/all-MiniLM-L6-v2.onnx /app/all-MiniLM-L6-v2.onnx
COPY --from=export /export/all-MiniLM-L6-v2.onnx.sha256 /app/all-MiniLM-L6-v2.onnx.sha256
COPY --from=export /hf /hf

# Create necessary directories and configure permissions
RUN mkdir -p /app/config /app/telemetry /app/pricing \
    && chown -R appuser:appuser /opt/migrate /app /hf

USER appuser

ENV HF_HOME=/hf \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    LANDAUER_CONFIG_PATH=/app/config/config.yaml \
    LANDAUER_TENANTS_PATH=/app/config/tenants.yaml \
    LANDAUER_EVENTS_PATH=/app/telemetry/gateway_events.jsonl \
    LANDAUER_PRICING_PATH=/app/pricing/pricing.yaml

EXPOSE 8080

CMD ["python", "start_gateway.py"]

