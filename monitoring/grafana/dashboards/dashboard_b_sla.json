  "panels": [
    {
      "id": 1,
      "title": "p95 TTFT per Tier vs SLO",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, request_tier)(rate(landauer_ttft_seconds_bucket[5m])))",
          "legendFormat": "{{request_tier}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1.0
              },
              {
                "color": "red",
                "value": 3.0
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "SLO Attainment (Premium & Free)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(landauer_ttft_seconds_bucket{request_tier=\"premium\",le=\"1.0\"}[5m])) / sum(rate(landauer_ttft_seconds_count{request_tier=\"premium\"}[5m]))",
          "legendFormat": "premium SLO (1.0s)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(landauer_ttft_seconds_bucket{request_tier=\"free\",le=\"3.0\"}[5m])) / sum(rate(landauer_ttft_seconds_count{request_tier=\"free\"}[5m]))",
          "legendFormat": "free SLO (3.0s)",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 3,
      "title": "Error Budget Consumed (Premium)",
      "description": "p95 / SLO, capped at 1.0; same definition as generate_report.py",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_max(histogram_quantile(0.95, sum by (le)(rate(landauer_ttft_seconds_bucket{request_tier=\"premium\"}[5m]))) / 1.0, 1)",
          "legendFormat": "budget consumed",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 4,
      "title": "Request Volume per Engine",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (engine)(rate(landauer_requests_total[1m]))",
          "legendFormat": "{{engine}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    }
